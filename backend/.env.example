# Server
PORT=3001

# Database
MONGO_URI=Mongo_URL

# JWT
# Required. Generate a unique value, never commit it:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN=7d

# Chroma Vector Store
CHROMA_URL=your-chroma-server-url

# Ollama LLM Server
OLLAMA_URL=your-ollama-server-url

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL (for CORS)
# Comma-separated allowlist of exact origins (never use "*")
FRONTEND_URL=Frontend_URL

# OCR Settings
OCR_MODEL=ocr-model
OCR_TIMEOUT_MS=120000
MAX_IMAGE_UPLOAD_SIZE=10485760

# Vision Model Settings
VISION_MODEL=llava-llama3:8b
VISION_MAX_IMAGE_SIZE=2097152
VISION_TIMEOUT_MS=180000

# Chat/Streaming Timeouts
CHAT_TIMEOUT_MS=180000
WEB_SEARCH_TIMEOUT_MS=60000

# Image Generation Settings
IMAGE_GEN_MODEL=image-gen-model
IMAGE_GEN_TIMEOUT_MS=180000
IMAGE_GEN_CONCURRENCY=1
DEFAULT_IMAGE_WIDTH=768
DEFAULT_IMAGE_HEIGHT=768
MAX_IMAGE_GEN_WIDTH=1024
MAX_IMAGE_GEN_HEIGHT=1024