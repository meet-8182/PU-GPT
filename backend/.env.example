# Server
PORT=3001

# Database
# MongoDB connection string - get from MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGO_URI=

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Web search API key (Tavily)
# Get from: https://tavily.com/
TAVILY_API_KEY=

# Chroma Vector Store
CHROMA_URL=http://localhost:8000

# Ollama LLM Server
OLLAMA_URL=http://localhost:11434

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL (for CORS)
# Comma-separated allowlist of exact origins (never use "*")
FRONTEND_URL=http://localhost:5173

# Reverse proxy hops (set to 1 when behind nginx/traefik)
# TRUST_PROXY=1

# Security
# ENABLE_DEBUG_ROUTES=false

# Authentication rate limiting / lockout
# RATE_LIMIT_LOGIN_PER_WINDOW=20
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_REGISTER_PER_WINDOW=10
# RATE_LIMIT_REGISTER_WINDOW_MS=3600000
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_MS=900000

# OCR Settings
OCR_MODEL=glm-ocr
OCR_TIMEOUT_MS=120000
MAX_IMAGE_UPLOAD_SIZE=10485760

# Vision Model Settings
VISION_MODEL=llava-llama3:8b
VISION_MAX_IMAGE_SIZE=2097152
VISION_TIMEOUT_MS=180000

# Chat/Streaming Timeouts
CHAT_TIMEOUT_MS=180000
WEB_SEARCH_TIMEOUT_MS=60000

# Speech-to-Text (STT)
STT_PROVIDER=faster-whisper
FASTER_WHISPER_SCRIPT=./stt/transcribe.py

# Whisper Model Settings
# Model: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Decoding parameters
WHISPER_BEAM_SIZE=5
WHISPER_TEMPERATURE=0.0
WHISPER_BEST_OF=5
WHISPER_PATIENCE=1.0
WHISPER_VAD_FILTER=true