# Server
PORT=3001

# Database
MONGO_URI=mongodb://localhost:27017/pu-gpt

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Chroma Vector Store
CHROMA_URL=http://localhost:8000

# Ollama LLM Server
OLLAMA_URL=http://localhost:11434

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# OCR Settings
OCR_MODEL=glm-ocr
OCR_TIMEOUT_MS=120000
MAX_IMAGE_UPLOAD_SIZE=10485760

# Vision Model Settings
VISION_MODEL=llava-llama3:8b
VISION_MAX_IMAGE_SIZE=2097152
VISION_TIMEOUT_MS=180000

# Chat/Streaming Timeouts
CHAT_TIMEOUT_MS=180000
WEB_SEARCH_TIMEOUT_MS=60000

# Image Generation Settings
IMAGE_GEN_MODEL=x/z-image-turbo
IMAGE_GEN_TIMEOUT_MS=180000
IMAGE_GEN_CONCURRENCY=1
DEFAULT_IMAGE_WIDTH=768
DEFAULT_IMAGE_HEIGHT=768
MAX_IMAGE_GEN_WIDTH=1024
MAX_IMAGE_GEN_HEIGHT=1024

# Initial Users (for create-users script)
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=your-secure-password
# ADMIN_NAME=Admin User
# ADMIN_DEPARTMENT=Administration

# TEACHER_EMAIL=teacher@yourdomain.com
# TEACHER_PASSWORD=your-secure-password
# TEACHER_NAME=Teacher User
# TEACHER_DEPARTMENT=Computer Science Engineering
# TEACHER_SUBJECTS=Data Structures,Algorithms,Database Systems

# STUDENT_EMAIL=student@yourdomain.com
# STUDENT_PASSWORD=your-secure-password
# STUDENT_NAME=Student User
# STUDENT_DEPARTMENT=Computer Science Engineering
# STUDENT_SUBJECTS=Data Structures,Algorithms