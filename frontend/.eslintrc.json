{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["react"],
  "rules": {
    "no-undef": "error",
    "react/jsx-no-undef": "error",
    "react/react-in-jsx-scope": "off"
  }
}